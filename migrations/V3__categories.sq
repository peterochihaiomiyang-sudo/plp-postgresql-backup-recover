-- V3: Hierarchical category table and sample rows.
CREATE TABLE IF NOT EXISTS public.categories (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name TEXT NOT NULL,
  parent_id BIGINT REFERENCES public.categories(id) ON DELETE RESTRICT
);

-- Insert the sample hierarchy only if these named rows are not already present.
INSERT INTO public.categories(name, parent_id)
SELECT 'Electronics', NULL
WHERE NOT EXISTS (
  SELECT 1 FROM public.categories WHERE name = 'Electronics' AND parent_id IS NULL
);

INSERT INTO public.categories(name, parent_id)
SELECT 'Computers', p.id
FROM public.categories p
WHERE p.name = 'Electronics' AND p.parent_id IS NULL
  AND NOT EXISTS (
    SELECT 1 FROM public.categories c
    WHERE c.name = 'Computers' AND c.parent_id = p.id
  );

INSERT INTO public.categories(name, parent_id)
SELECT 'Laptops', p.id
FROM public.categories p
JOIN public.categories root ON root.id = p.parent_id
WHERE p.name = 'Computers' AND root.name = 'Electronics'
  AND NOT EXISTS (
    SELECT 1 FROM public.categories c
    WHERE c.name = 'Laptops' AND c.parent_id = p.id
  );

INSERT INTO public.categories(name, parent_id)
SELECT 'Phones', p.id
FROM public.categories p
WHERE p.name = 'Electronics' AND p.parent_id IS NULL
  AND NOT EXISTS (
    SELECT 1 FROM public.categories c
    WHERE c.name = 'Phones' AND c.parent_id = p.id
  );
